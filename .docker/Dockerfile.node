FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# systemd + SSH + python (for the service banner listener)
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv openssh-server \
    python3 python3-apt sudo iproute2 procps \
    && rm -rf /var/lib/apt/lists/*

# Mask container-hostile units
RUN systemctl mask \
    dev-hugepages.mount sys-fs-fuse-connections.mount \
    systemd-udev-trigger.service systemd-udevd.service \
    systemd-update-utmp.service systemd-logind.service \
    getty@.service getty.target

RUN systemctl enable ssh
RUN mkdir -p /run/sshd

# cadet: key-based access for Ansible (authorized_keys bind-mounted read-only)
RUN useradd -m -s /bin/bash cadet \
    && echo 'cadet ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers.d/cadet \
    && chmod 0440 /etc/sudoers.d/cadet \
    && mkdir -p /home/cadet/.ssh && chmod 700 /home/cadet/.ssh \
    && chown -R cadet:cadet /home/cadet/.ssh

# Ansible local fact: exposes ansible_local.sdc.nonce, read live from
# /etc/sdc/nonce (planted by setup-lab.sh / rotate-lab.sh). Retrievable ONLY via
# a live `ansible -m setup` sweep — this is the anti-hardcode attestation.
RUN mkdir -p /etc/ansible/facts.d /etc/sdc
COPY sdc-fact.sh /etc/ansible/facts.d/sdc.fact
RUN chmod +x /etc/ansible/facts.d/sdc.fact

# -- Service banner listener -------------------------------------------------
# A tiny TCP listener that marks a role port as "open" for fingerprinting.
# Bound to 0.0.0.0 so it keeps serving after a live IP rotation (no restart).
# Managed as a systemd template unit: `sdc-listener@<port>` (instance = port).
COPY sdc-listener.py /usr/local/bin/sdc-listener
COPY sdc-listener@.service /etc/systemd/system/sdc-listener@.service
RUN chmod 0755 /usr/local/bin/sdc-listener

EXPOSE 22
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
